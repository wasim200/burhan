<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>إدارة المستخدمين - نظام التوقيع الرقمي</title>
    <link rel="stylesheet" href="/css/style.css">
    <style>
        .admin-wrapper {
            background: #f8f9fa;
            min-height: 100vh;
            padding: 30px 0;
        }
        .admin-header {
            background: linear-gradient(135deg, #dc3545, #c82333);
            color: white;
            border-radius: 15px;
            padding: 30px;
            margin-bottom: 30px;
            box-shadow: 0 10px 30px rgba(220, 53, 69, 0.3);
        }
        .admin-header h1 {
            font-size: 1.8rem;
            margin-bottom: 10px;
        }
        .filter-card {
            background: white;
            border-radius: 15px;
            padding: 25px;
            margin-bottom: 25px;
            box-shadow: 0 5px 15px rgba(0,0,0,0.08);
        }
        .filter-card .form-control, .filter-card .btn {
            height: 50px;
            border-radius: 10px;
        }
        .admin-card {
            background: white;
            border-radius: 15px;
            box-shadow: 0 5px 15px rgba(0,0,0,0.08);
            overflow: hidden;
        }
        .table-admin {
            margin: 0;
        }
        .table-admin thead {
            background: #f8f9fa;
        }
        .table-admin thead th {
            padding: 15px;
            color: #dc3545;
            font-weight: 600;
            border: none;
        }
        .table-admin tbody tr {
            transition: all 0.3s ease;
        }
        .table-admin tbody tr:hover {
            background: #f8f9fa;
        }
        .table-admin tbody td {
            padding: 15px;
            vertical-align: middle;
        }
        .user-avatar-admin {
            width: 45px;
            height: 45px;
            border-radius: 50%;
            background: linear-gradient(135deg, #dc3545, #c82333);
            color: white;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 600;
            font-size: 18px;
        }
        .status-select {
            padding: 8px 12px;
            border-radius: 8px;
            border: 2px solid #dee2e6;
        }
        .pagination-admin {
            display: flex;
            justify-content: center;
            gap: 5px;
            margin-top: 25px;
        }
        .page-link-admin {
            padding: 10px 15px;
            background: white;
            border: 2px solid #dee2e6;
            border-radius: 8px;
            text-decoration: none;
            color: #dc3545;
            font-weight: 600;
            transition: all 0.3s ease;
        }
        .page-link-admin:hover, .page-link-admin.active {
            background: #dc3545;
            color: white;
            border-color: #dc3545;
        }
    </style>
</head>
<body>
    <%- include('../partials/header', {currentPage: 'admin', user: user}) %>
    
    <div class="admin-wrapper">
        <div class="container">
            <!-- Admin Header -->
            <div class="admin-header">
                <h1>
                    <i class="fas fa-users-cog me-2"></i>
                    إدارة المستخدمين
                </h1>
                <p class="mb-0" style="opacity: 0.95;">
                    <i class="fas fa-list me-2"></i>
                    إدارة جميع مستخدمي النظام وتحديث حالاتهم
                </p>
            </div>

            <!-- Statistics Cards -->
            <div class="row mb-4">
                <% 
                    let activeUsers = users.filter(u => u.status === 'active').length;
                    let expiringSoon = users.filter(u => u.daysRemaining > 0 && u.daysRemaining <= 7).length;
                    let expiredUsers = users.filter(u => u.status === 'expired' || u.daysRemaining <= 0).length;
                    let inactiveUsers = users.filter(u => u.status === 'inactive').length;
                %>
                <div class="col-md-3 mb-3">
                    <div class="card" style="border: none; border-radius: 15px; box-shadow: 0 5px 15px rgba(0,0,0,0.08); background: linear-gradient(135deg, #28a745, #20c997); color: white;">
                        <div class="card-body text-center">
                            <i class="fas fa-check-circle" style="font-size: 40px; margin-bottom: 10px; opacity: 0.9;"></i>
                            <h3 class="mb-0" style="font-size: 2rem; font-weight: 700;"><%= activeUsers %></h3>
                            <p class="mb-0" style="opacity: 0.95;">مستخدم نشط</p>
                        </div>
                    </div>
                </div>
                <div class="col-md-3 mb-3">
                    <div class="card" style="border: none; border-radius: 15px; box-shadow: 0 5px 15px rgba(0,0,0,0.08); background: linear-gradient(135deg, #ffc107, #ff9800); color: white;">
                        <div class="card-body text-center">
                            <i class="fas fa-exclamation-triangle" style="font-size: 40px; margin-bottom: 10px; opacity: 0.9;"></i>
                            <h3 class="mb-0" style="font-size: 2rem; font-weight: 700;"><%= expiringSoon %></h3>
                            <p class="mb-0" style="opacity: 0.95;">ينتهي قريباً (≤7 أيام)</p>
                        </div>
                    </div>
                </div>
                <div class="col-md-3 mb-3">
                    <div class="card" style="border: none; border-radius: 15px; box-shadow: 0 5px 15px rgba(0,0,0,0.08); background: linear-gradient(135deg, #dc3545, #c82333); color: white;">
                        <div class="card-body text-center">
                            <i class="fas fa-hourglass-end" style="font-size: 40px; margin-bottom: 10px; opacity: 0.9;"></i>
                            <h3 class="mb-0" style="font-size: 2rem; font-weight: 700;"><%= expiredUsers %></h3>
                            <p class="mb-0" style="opacity: 0.95;">اشتراك منتهي</p>
                        </div>
                    </div>
                </div>
                <div class="col-md-3 mb-3">
                    <div class="card" style="border: none; border-radius: 15px; box-shadow: 0 5px 15px rgba(0,0,0,0.08); background: linear-gradient(135deg, #6c757d, #5a6268); color: white;">
                        <div class="card-body text-center">
                            <i class="fas fa-user-slash" style="font-size: 40px; margin-bottom: 10px; opacity: 0.9;"></i>
                            <h3 class="mb-0" style="font-size: 2rem; font-weight: 700;"><%= inactiveUsers %></h3>
                            <p class="mb-0" style="opacity: 0.95;">غير مفعّل</p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Search & Filter -->
            <div class="filter-card">
                <form method="GET" class="row g-3">
                    <div class="col-md-7">
                        <div class="input-group">
                            <span class="input-group-text" style="background: #dc3545; color: white; border: none;">
                                <i class="fas fa-search"></i>
                            </span>
                            <input type="text" name="search" placeholder="ابحث بالاسم أو البريد الإلكتروني..." 
                                   value="<%= search %>" class="form-control">
                        </div>
                    </div>
                    <div class="col-md-3">
                        <select name="limit" class="form-control" onchange="this.form.submit()">
                            <option value="10" <%= limit == 10 ? 'selected' : '' %>>10 نتائج</option>
                            <option value="25" <%= limit == 25 ? 'selected' : '' %>>25 نتيجة</option>
                            <option value="50" <%= limit == 50 ? 'selected' : '' %>>50 نتيجة</option>
                        </select>
                    </div>
                    <div class="col-md-2">
                        <button type="submit" class="btn btn-danger w-100">
                            <i class="fas fa-filter me-2"></i>بحث
                        </button>
                    </div>
                </form>
            </div>

            <!-- Users Table -->
            <div class="admin-card">
                <% if (users.length > 0) { %>
                    <div class="table-responsive">
                        <table class="table-admin table table-hover">
                            <thead>
                                <tr>
                                    <th><i class="fas fa-user me-2"></i>المستخدم</th>
                                    <th><i class="fas fa-envelope me-2"></i>البريد الإلكتروني</th>
                                    <th><i class="fas fa-shield-alt me-2"></i>حالة الاشتراك</th>
                                    <th class="text-center"><i class="fas fa-hourglass-half me-2"></i>الأيام المتبقية</th>
                                    <th><i class="fas fa-calendar me-2"></i>تاريخ التسجيل</th>
                                    <th class="text-center"><i class="fas fa-cogs me-2"></i>الإجراءات</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% users.forEach(user => { %>
                                    <tr>
                                        <td>
                                            <div class="d-flex align-items-center gap-3">
                                                <div class="user-avatar-admin">
                                                    <%= user.username.charAt(0).toUpperCase() %>
                                                </div>
                                                <strong style="color: #dc3545;"><%= user.username %></strong>
                                            </div>
                                        </td>
                                        <td><%= user.email %></td>
                                        <td>
                                            <span class="badge <%= user.status === 'active' ? 'bg-success' : user.status === 'pending' ? 'bg-warning text-dark' : user.status === 'expired' ? 'bg-danger' : 'bg-secondary' %>">
                                                <i class="fas <%= user.status === 'active' ? 'fa-check-circle' : user.status === 'pending' ? 'fa-clock' : user.status === 'expired' ? 'fa-hourglass-end' : 'fa-times-circle' %> me-1"></i>
                                                <%= user.status === 'active' ? 'نشط' : user.status === 'pending' ? 'قيد المراجعة' : user.status === 'expired' ? 'منتهي' : 'غير نشط' %>
                                            </span>
                                        </td>
                                        <td class="text-center">
                                            <% if (user.subscription.endDate) { %>
                                                <% 
                                                    let badgeClass = '';
                                                    let icon = '';
                                                    if (user.daysRemaining > 30) {
                                                        badgeClass = 'bg-success';
                                                        icon = 'fa-check-circle';
                                                    } else if (user.daysRemaining > 7) {
                                                        badgeClass = 'bg-warning text-dark';
                                                        icon = 'fa-exclamation-triangle';
                                                    } else if (user.daysRemaining > 0) {
                                                        badgeClass = 'bg-danger';
                                                        icon = 'fa-hourglass-end';
                                                    } else {
                                                        badgeClass = 'bg-dark';
                                                        icon = 'fa-times-circle';
                                                    }
                                                %>
                                                <span class="badge <%= badgeClass %>" style="font-size: 13px; padding: 8px 12px;">
                                                    <i class="fas <%= icon %> me-1"></i>
                                                    <strong><%= user.daysRemaining %></strong> يوم
                                                </span>
                                                <% if (user.subscription.endDate) { %>
                                                    <br><small class="text-muted" style="font-size: 11px;">
                                                        ينتهي: <%= new Date(user.subscription.endDate).toLocaleDateString('ar-SA') %>
                                                    </small>
                                                <% } %>
                                            <% } else { %>
                                                <span class="badge bg-secondary">
                                                    <i class="fas fa-minus me-1"></i>غير محدد
                                                </span>
                                            <% } %>
                                        </td>
                                        <td><small><%= new Date(user.createdAt).toLocaleDateString('ar-SA') %></small></td>
                                        <td>
                                            <div class="d-flex gap-2 justify-content-center align-items-center flex-wrap">
                                                <button class="btn btn-sm btn-success activate-user" data-user-id="<%= user._id %>" data-user-name="<%= user.username %>" title="تفعيل المستخدم">
                                                    <i class="fas fa-check-circle me-1"></i>تفعيل
                                                </button>
                                                <select class="status-select" data-user-id="<%= user._id %>" style="width: auto;">
                                                    <option value="active" <%= user.subscription.status === 'active' ? 'selected' : '' %>>✓ نشط</option>
                                                    <option value="inactive" <%= user.subscription.status === 'inactive' ? 'selected' : '' %>>✗ غير نشط</option>
                                                    <option value="expired" <%= user.subscription.status === 'expired' ? 'selected' : '' %>>⏰ منتهي</option>
                                                </select>
                                                <button class="btn btn-sm btn-danger delete-user" data-user-id="<%= user._id %>" data-user-name="<%= user.username %>">
                                                    <i class="fas fa-trash"></i>
                                                </button>
                                            </div>
                                        </td>
                                    </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>

                    <!-- Pagination -->
                    <% if (totalPages > 1) { %>
                        <div class="pagination-admin p-3">
                            <% if (currentPage > 1) { %>
                                <a href="?page=<%= currentPage - 1 %>&limit=<%= limit %>&search=<%= search %>" class="page-link-admin">
                                    <i class="fas fa-chevron-right me-1"></i>السابق
                                </a>
                            <% } %>
                            
                            <% for (let i = 1; i <= totalPages; i++) { %>
                                <a href="?page=<%= i %>&limit=<%= limit %>&search=<%= search %>" 
                                   class="page-link-admin <%= currentPage === i ? 'active' : '' %>">
                                    <%= i %>
                                </a>
                            <% } %>
                            
                            <% if (currentPage < totalPages) { %>
                                <a href="?page=<%= currentPage + 1 %>&limit=<%= limit %>&search=<%= search %>" class="page-link-admin">
                                    التالي<i class="fas fa-chevron-left ms-1"></i>
                                </a>
                            <% } %>
                        </div>
                    <% } %>
                <% } else { %>
                    <div class="text-center py-5">
                        <i class="fas fa-users-slash" style="font-size: 80px; color: #dee2e6;"></i>
                        <h4 class="mt-4 text-muted">لا يوجد مستخدمين</h4>
                        <p class="text-muted">لم يتم العثور على أي نتائج</p>
                    </div>
                <% } %>
            </div>
        </div>
    </div>
    
    <%- include('../partials/footer') %>
    
    <%- include('../partials/footer') %>

    <script>
        // تفعيل المستخدم مع تحديد المدة
        document.querySelectorAll('.activate-user').forEach(button => {
            button.addEventListener('click', async function() {
                const userId = this.dataset.userId;
                const userName = this.dataset.userName;
                
                // عرض نافذة لإدخال مدة الاشتراك
                const daysOptions = [
                    { value: 7, label: '7 أيام (أسبوع)' },
                    { value: 15, label: '15 يوم' },
                    { value: 30, label: '30 يوم (شهر)' },
                    { value: 90, label: '90 يوم (3 أشهر)' },
                    { value: 180, label: '180 يوم (6 أشهر)' },
                    { value: 365, label: '365 يوم (سنة)' }
                ];
                
                let optionsHtml = daysOptions.map(opt => 
                    `<option value="${opt.value}">${opt.label}</option>`
                ).join('');
                
                const promptHtml = `
                    <div style="font-family: Arial, sans-serif; text-align: center;">
                        <h3 style="color: #136d62; margin-bottom: 15px;">⚡ تفعيل المستخدم: ${userName}</h3>
                        <p style="margin-bottom: 20px;">حدد مدة الاشتراك:</p>
                        <select id="durationSelect" style="width: 100%; padding: 12px; border: 2px solid #136d62; border-radius: 8px; font-size: 16px; margin-bottom: 15px;">
                            ${optionsHtml}
                        </select>
                        <div style="margin-top: 20px;">
                            <button onclick="confirmActivation()" style="background: #28a745; color: white; padding: 12px 30px; border: none; border-radius: 8px; cursor: pointer; font-size: 16px; margin-right: 10px;">
                                ✅ تفعيل
                            </button>
                            <button onclick="closePrompt()" style="background: #dc3545; color: white; padding: 12px 30px; border: none; border-radius: 8px; cursor: pointer; font-size: 16px;">
                                ❌ إلغاء
                            </button>
                        </div>
                    </div>
                `;
                
                const overlay = document.createElement('div');
                overlay.id = 'activationOverlay';
                overlay.style.cssText = 'position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.7); z-index: 9999; display: flex; align-items: center; justify-content: center;';
                
                const promptBox = document.createElement('div');
                promptBox.style.cssText = 'background: white; padding: 30px; border-radius: 15px; box-shadow: 0 10px 40px rgba(0,0,0,0.3); max-width: 500px; width: 90%;';
                promptBox.innerHTML = promptHtml;
                
                overlay.appendChild(promptBox);
                document.body.appendChild(overlay);
                
                // دالة التفعيل
                window.confirmActivation = async function() {
                    const durationDays = document.getElementById('durationSelect').value;
                    
                    try {
                        const response = await fetch(`/admin/users/${userId}/activate`, {
                            method: 'POST',
                            headers: {
                                'Content-Type': 'application/json'
                            },
                            body: JSON.stringify({ durationDays })
                        });
                        
                        const data = await response.json();
                        
                        if (data.success) {
                            alert('✅ ' + data.message);
                            location.reload();
                        } else {
                            alert('❌ فشل في تفعيل المستخدم: ' + data.message);
                        }
                    } catch (error) {
                        console.error('Error:', error);
                        alert('❌ حدث خطأ أثناء تفعيل المستخدم');
                    }
                    
                    document.getElementById('activationOverlay').remove();
                };
                
                // دالة الإلغاء
                window.closePrompt = function() {
                    document.getElementById('activationOverlay').remove();
                };
            });
        });
        
        // تحديث حالة المستخدم
        document.querySelectorAll('.status-select').forEach(select => {
            select.addEventListener('change', async function() {
                const userId = this.dataset.userId;
                const status = this.value;
                
                if (confirm('هل تريد تغيير حالة المستخدم؟')) {
                    try {
                        const response = await fetch(`/admin/users/${userId}/status`, {
                            method: 'POST',
                            headers: {
                                'Content-Type': 'application/json'
                            },
                            body: JSON.stringify({ status })
                        });
                        
                        const data = await response.json();
                        
                        if (data.success) {
                            alert('✅ تم تحديث حالة المستخدم بنجاح');
                            location.reload();
                        } else {
                            alert('❌ فشل في تحديث حالة المستخدم: ' + data.message);
                        }
                    } catch (error) {
                        console.error('Error:', error);
                        alert('❌ حدث خطأ أثناء تحديث حالة المستخدم');
                    }
                }
            });
        });

        // حذف المستخدم
        document.querySelectorAll('.delete-user').forEach(button => {
            button.addEventListener('click', function() {
                const userId = this.dataset.userId;
                const userName = this.dataset.userName;
                
                if (confirm(`⚠️ هل أنت متأكد من أنك تريد حذف المستخدم "${userName}"؟\n\nهذا الإجراء لا يمكن التراجع عنه!`)) {
                    fetch(`/admin/users/${userId}`, {
                        method: 'DELETE'
                    })
                    .then(response => response.json())
                    .then(data => {
                        if (data.success) {
                            alert('✅ تم حذف المستخدم بنجاح');
                            location.reload();
                        } else {
                            alert('❌ فشل في حذف المستخدم: ' + data.message);
                        }
                    })
                    .catch(error => {
                        console.error('Error:', error);
                        alert('❌ حدث خطأ أثناء حذف المستخدم');
                    });
                }
            });
        });
    </script>
</body>
</html>