<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>عرض الباركود - بٌـرهــان</title>
  <link rel="stylesheet" href="/css/style.css">
  <style>
    body {
      background: #f8f9fa;
    }
    .view-wrapper {
      min-height: 100vh;
      padding: 30px 0;
    }
    .view-card {
      background: white;
      border-radius: 15px;
      box-shadow: 0 10px 30px rgba(0,0,0,0.1);
      overflow: hidden;
      max-width: 800px;
      margin: 0 auto;
    }
    .view-header {
      background: linear-gradient(135deg, #136d62, #0a4d45);
      color: white;
      padding: 30px;
      text-align: center;
    }
    .view-header h1 {
      font-size: 1.8rem;
      margin: 0 0 10px 0;
    }
    .view-body {
      padding: 40px 30px;
    }
    .qr-container {
      text-align: center;
      padding: 30px;
      background: #f8f9fa;
      border-radius: 15px;
      margin-bottom: 30px;
    }
    .qr-container img {
      max-width: 300px;
      border: 5px solid white;
      border-radius: 10px;
      box-shadow: 0 5px 15px rgba(0,0,0,0.1);
    }
    .info-grid {
      display: grid;
      gap: 20px;
      margin-top: 30px;
    }
    .info-item {
      background: #f8f9fa;
      padding: 20px;
      border-radius: 10px;
      border-right: 4px solid #136d62;
    }
    .info-item label {
      font-weight: 600;
      color: #136d62;
      display: block;
      margin-bottom: 8px;
    }
    .info-item .value {
      color: #333;
      font-size: 1rem;
    }
    .btn-group {
      display: flex;
      gap: 10px;
      flex-wrap: wrap;
      margin-top: 30px;
    }
    .btn {
      flex: 1;
      min-width: 150px;
      padding: 12px 20px;
      border: none;
      border-radius: 10px;
      font-weight: 600;
      cursor: pointer;
      transition: all 0.3s;
      text-decoration: none;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
    }
    .btn-primary {
      background: #136d62;
      color: white;
    }
    .btn-primary:hover {
      background: #0a4d45;
      transform: translateY(-2px);
      box-shadow: 0 5px 15px rgba(19,109,98,0.3);
    }
    .btn-secondary {
      background: #6c757d;
      color: white;
    }
    .btn-secondary:hover {
      background: #5a6268;
      transform: translateY(-2px);
    }
    .btn-success {
      background: #28a745;
      color: white;
    }
    .btn-success:hover {
      background: #218838;
      transform: translateY(-2px);
    }
    @media print {
      .btn-group, header, footer {
        display: none !important;
      }
    }
  </style>
</head>
<body>
  <%- include('../partials/header', {currentPage: '', user: user}) %>

  <div class="view-wrapper">
    <div class="container">
      <div class="view-card">
        <div class="view-header">
          <h1>
            <i class="fas fa-qrcode me-2"></i>
            <%= barcode.documentName %>
          </h1>
          <p class="mb-0" style="opacity: 0.9;">معلومات الباركود الكاملة</p>
        </div>

        <div class="view-body">
          <!-- QR Code -->
          <div class="qr-container">
            <img src="<%= qrCodeData %>" alt="QR Code">
            <p class="mt-3" style="color: #666; font-size: 14px;">
              <i class="fas fa-info-circle me-1"></i>
              امسح هذا الرمز باستخدام أي قارئ QR
            </p>
          </div>

          <!-- معلومات الباركود -->
          <div class="info-grid">
            <div class="info-item">
              <label><i class="fas fa-file-alt me-2"></i>اسم الوثيقة</label>
              <div class="value"><%= barcode.documentName %></div>
            </div>

            <div class="info-item">
              <label><i class="fas fa-fingerprint me-2"></i>معرف الباركود</label>
              <div class="value"><code style="background: white; padding: 5px 10px; border-radius: 5px;"><%= barcode._id %></code></div>
            </div>

            <div class="info-item">
              <label><i class="fas fa-calendar me-2"></i>تاريخ الإنشاء</label>
              <div class="value"><%= new Date(barcode.timestamp || barcode.createdAt).toLocaleString('ar-SA') %></div>
            </div>

            <div class="info-item">
              <label><i class="fas fa-eye me-2"></i>عدد مرات المسح</label>
              <div class="value"><%= barcode.scannedCount || 0 %> مرة</div>
            </div>

            <div class="info-item">
              <label><i class="fas fa-lock me-2"></i>Hash الوثيقة</label>
              <div class="value" style="word-break: break-all; font-size: 12px; font-family: monospace;">
                <%= barcode.originalHash %>
              </div>
            </div>
          </div>

          <!-- الأزرار -->
          <div class="btn-group">
            <a href="/barcode/print/<%= barcode._id %>" target="_blank" class="btn btn-success">
              <i class="fas fa-print"></i>
              طباعة
            </a>
            <button onclick="window.print()" class="btn btn-primary">
              <i class="fas fa-print"></i>
              طباعة سريعة
            </button>
            <a href="/barcode/list" class="btn btn-secondary">
              <i class="fas fa-arrow-right"></i>
              العودة للقائمة
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>

  <%- include('../partials/footer') %>
</body>
</html>
