<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>نتيجة القراءة - نظام التوقيع الرقمي</title>
    <link rel="stylesheet" href="/css/style.css">
    <style>
        .document-content-wrapper {
            background: #f8f9fa;
            border-radius: 8px;
            padding: 20px;
            margin: 15px 0;
        }
        .document-content-pre {
            background: white;
            border: 1px solid #dee2e6;
            border-radius: 6px;
            padding: 15px;
            white-space: pre-wrap;
            word-wrap: break-word;
            overflow-wrap: break-word;
            max-width: 100%;
            margin: 0;
            font-family: 'Courier New', monospace;
            font-size: 14px;
            line-height: 1.6;
            color: #212529;
        }
        .hash-display {
            word-break: break-all;
            display: block;
            padding: 12px;
            background: #fff3cd;
            border: 1px solid #ffc107;
            border-radius: 6px;
            font-family: 'Courier New', monospace;
            font-size: 13px;
            color: #856404;
            margin-top: 10px;
        }
        .info-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 15px;
            margin-bottom: 20px;
        }
        .info-item {
            background: white;
            padding: 15px;
            border-radius: 8px;
            border-left: 4px solid #136d62;
        }
        .info-label {
            font-size: 13px;
            color: #6c757d;
            margin-bottom: 5px;
        }
        .info-value {
            font-size: 16px;
            font-weight: 600;
            color: #212529;
        }
        @media print {
            .btn, .d-flex { display: none !important; }
            .document-content-pre { font-size: 12px; }
        }
    </style>
</head>
<body>
    <%- include('../partials/header', {currentPage: 'read-barcode', user: user}) %>
    
    <div class="dashboard">
        <div class="container py-3">
            <div class="dashboard-header mb-4">
                <h1 class="h3 mb-0">نتيجة قراءة الباركود</h1>
            </div>

            <% if (success) { %>
                <div class="alert alert-success">
                    <h3>✅ تمت قراءة الباركود بنجاح!</h3>
                </div>

                <div class="info-grid">
                    <div class="info-item">
                        <div class="info-label"><i class="fas fa-file-alt text-primary"></i> اسم الوثيقة</div>
                        <div class="info-value"><%= documentName %></div>
                    </div>
                    <div class="info-item">
                        <div class="info-label"><i class="fas fa-calendar-alt text-info"></i> تاريخ الإنشاء</div>
                        <div class="info-value"><%= new Date(timestamp).toLocaleString('ar-SA') %></div>
                    </div>
                    <div class="info-item">
                        <div class="info-label"><i class="fas fa-shield-alt text-success"></i> حالة التوقيع</div>
                        <div class="info-value">
                            <span class="status-badge <%= signatureValid ? 'status-active' : 'status-expired' %>">
                                <i class="fas <%= signatureValid ? 'fa-check-circle' : 'fa-times-circle' %>"></i>
                                <%= signatureValid ? 'صالح' : 'غير صالح' %>
                            </span>
                        </div>
                    </div>
                    <div class="info-item">
                        <div class="info-label"><i class="fas fa-eye text-secondary"></i> عدد مرات المسح</div>
                        <div class="info-value"><%= scannedCount %></div>
                    </div>
                </div>

                <div class="card shadow-sm">
                    <div class="card-header bg-primary text-white">
                        <h3 class="h5 mb-0"><i class="fas fa-file-contract me-2"></i>محتوى الوثيقة</h3>
                    </div>
                    <div class="card-body">
                        <div class="document-content-wrapper">
                            <pre class="document-content-pre"><%= documentData %></pre>
                        </div>
                        <div class="mt-3">
                            <strong class="d-block mb-2"><i class="fas fa-fingerprint text-warning me-2"></i>هاش الوثيقة:</strong>
                            <code class="hash-display"><%= documentHash %></code>
                        </div>
                    </div>
                </div>

                <% if (typeof documentImage !== 'undefined' && documentImage) { %>
                <!-- صورة الوثيقة المرفقة -->
                <div class="card shadow-sm mt-4">
                    <div class="card-header" style="background: linear-gradient(135deg, #136d62, #0a4d45); color: white;">
                        <h3 class="h5 mb-0"><i class="fas fa-image me-2"></i>صورة الوثيقة المرفقة</h3>
                    </div>
                    <div class="card-body text-center" style="background: #f8f9fa;">
                        <img src="data:image/jpeg;base64,<%= documentImage %>" 
                             alt="صورة الوثيقة" 
                             style="max-width: 100%; max-height: 600px; border-radius: 10px; box-shadow: 0 5px 15px rgba(0,0,0,0.2);">
                        <p class="mt-3 text-muted">
                            <i class="fas fa-file-image me-1"></i>
                            اسم الملف: <%= typeof documentImageName !== 'undefined' ? documentImageName : 'صورة الوثيقة' %>
                        </p>
                    </div>
                </div>
                <% } %>

                <div class="d-flex justify-content-center gap-2 mt-4">
                    <a href="/barcode/read" class="btn btn-primary"><i class="fas fa-qrcode me-2"></i>قراءة باركود آخر</a>
                    <button onclick="window.print()" class="btn btn-success"><i class="fas fa-print me-2"></i>طباعة النتيجة</button>
                </div>
            <% } else { %>
                <div class="alert alert-danger">
                    <p><%= message %></p>
                </div>
                
                <div class="text-center mt-4">
                    <a href="/barcode/read" class="btn btn-primary">المحاولة مرة أخرى</a>
                </div>
            <% } %>
        </div>
    </div>
    
    <%- include('../partials/footer') %>
</body>
</html>