<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>عرض الملف الشخصي - نظام التوقيع الرقمي</title>
  <link rel="stylesheet" href="/css/style.css">
  <link rel="icon" href="/images/favicon.ico" type="image/x-icon">
  <style>
    .profile-wrapper {
      background: #f8f9fa;
      min-height: 100vh;
      padding: 30px 0;
    }
    .profile-header {
      background: linear-gradient(135deg, #136d62, #0a4d45);
      color: white;
      border-radius: 15px;
      padding: 40px;
      margin-bottom: 30px;
      box-shadow: 0 10px 30px rgba(19, 109, 98, 0.3);
      position: relative;
      overflow: hidden;
    }
    .profile-header::before {
      content: '';
      position: absolute;
      top: -50%;
      right: -10%;
      width: 300px;
      height: 300px;
      background: rgba(255,255,255,0.05);
      border-radius: 50%;
    }
    .avatar-wrapper {
      position: relative;
      width: 120px;
      height: 120px;
      margin: 0 auto 20px;
    }
    .avatar-img {
      width: 120px;
      height: 120px;
      border-radius: 50%;
      object-fit: cover;
      border: 5px solid white;
      box-shadow: 0 5px 20px rgba(0,0,0,0.2);
    }
    .avatar-placeholder {
      width: 120px;
      height: 120px;
      border-radius: 50%;
      background: rgba(255,255,255,0.2);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 50px;
      color: white;
      border: 5px solid white;
      box-shadow: 0 5px 20px rgba(0,0,0,0.2);
    }
    .status-badge {
      padding: 8px 20px;
      border-radius: 20px;
      font-weight: 600;
      font-size: 14px;
      display: inline-flex;
      align-items: center;
      gap: 8px;
    }
    .status-active {
      background: #d4edda;
      color: #155724;
    }
    .status-inactive {
      background: #fff3cd;
      color: #856404;
    }
    .status-expired {
      background: #f8d7da;
      color: #721c24;
    }
    .info-card {
      background: white;
      border-radius: 15px;
      box-shadow: 0 5px 15px rgba(0,0,0,0.08);
      overflow: hidden;
      border: none;
      margin-bottom: 20px;
    }
    .card-header-custom {
      background: linear-gradient(135deg, #e3f2fd, #bbdefb);
      padding: 20px 30px;
      border-bottom: 3px solid #136d62;
    }
    .card-header-custom h3 {
      color: #136d62;
      margin: 0;
      font-size: 1.3rem;
    }
    .info-item {
      padding: 20px;
      border-bottom: 1px solid #f0f0f0;
      transition: all 0.3s ease;
    }
    .info-item:last-child {
      border-bottom: none;
    }
    .info-item:hover {
      background: #f8f9fa;
    }
    .info-label {
      color: #6c757d;
      font-size: 13px;
      margin-bottom: 8px;
      display: flex;
      align-items: center;
      gap: 8px;
    }
    .info-value {
      color: #136d62;
      font-size: 16px;
      font-weight: 600;
    }
    .btn-edit {
      background: white;
      color: #136d62;
      border: 2px solid white;
      padding: 12px 30px;
      border-radius: 10px;
      font-weight: 600;
      text-decoration: none;
      transition: all 0.3s ease;
      display: inline-flex;
      align-items: center;
      gap: 10px;
    }
    .btn-edit:hover {
      background: rgba(255,255,255,0.1);
      transform: translateY(-2px);
      color: white;
    }
    @media (max-width: 768px) {
      .profile-header {
        padding: 30px 20px;
      }
    }
  </style>
</head>
<body>
  <%- include('partials/header', {currentPage: 'profile', user: user}) %>

  <div class="profile-wrapper">
    <div class="container">
      <!-- Profile Header -->
      <div class="profile-header text-center">
        <div class="avatar-wrapper">
          <% if (user.avatarUrl) { %>
            <img src="<%= user.avatarUrl %>" alt="avatar" class="avatar-img">
          <% } else { %>
            <div class="avatar-placeholder">
              <i class="fas fa-user"></i>
            </div>
          <% } %>
        </div>
        <h1 class="mb-2"><%= user.username %></h1>
        <p class="mb-3" style="opacity: 0.9;">
          <i class="fas fa-envelope me-2"></i>
          <%= user.email %>
        </p>
        <div class="mb-3">
          <% 
            let statusClass = 'status-expired';
            let statusIcon = 'fa-times-circle';
            let statusText = 'لا يوجد اشتراك';
            
            if (user.subscription && user.subscription.status === 'active') {
              statusClass = 'status-active';
              statusIcon = 'fa-check-circle';
              statusText = 'اشتراك نشط';
            } else if (user.subscription && user.subscription.status === 'inactive') {
              statusClass = 'status-inactive';
              statusIcon = 'fa-exclamation-circle';
              statusText = 'اشتراك غير نشط';
            }
          %>
          <span class="status-badge <%= statusClass %>">
            <i class="fas <%= statusIcon %>"></i>
            <%= statusText %>
          </span>
        </div>
        <a href="/profile" class="btn-edit">
          <i class="fas fa-user-edit"></i>
          تعديل الملف الشخصي
        </a>
      </div>

      <!-- Account Info -->
      <div class="info-card">
        <div class="card-header-custom">
          <h3>
            <i class="fas fa-info-circle me-2"></i>
            بيانات الحساب
          </h3>
        </div>
        <div class="row g-0">
          <div class="col-12 col-md-6">
            <div class="info-item">
              <div class="info-label">
                <i class="fas fa-user"></i>
                اسم المستخدم
              </div>
              <div class="info-value"><%= user.username %></div>
            </div>
          </div>
          <div class="col-12 col-md-6">
            <div class="info-item">
              <div class="info-label">
                <i class="fas fa-envelope"></i>
                البريد الإلكتروني
              </div>
              <div class="info-value"><%= user.email %></div>
            </div>
          </div>
          <div class="col-12 col-md-6">
            <div class="info-item">
              <div class="info-label">
                <i class="fas fa-phone"></i>
                رقم الهاتف
              </div>
              <div class="info-value"><%= user.phone || 'غير محدد' %></div>
            </div>
          </div>
          <div class="col-12 col-md-6">
            <div class="info-item">
              <div class="info-label">
                <i class="fas fa-crown"></i>
                خطة الاشتراك
              </div>
              <div class="info-value"><%= user.subscription && user.subscription.plan ? user.subscription.plan : 'غير محدد' %></div>
            </div>
          </div>
        </div>
      </div>

      <!-- Actions -->
      <div class="text-center mt-4">
        <a href="/dashboard" class="btn-edit" style="background: linear-gradient(135deg, #136d62, #0a4d45); color: white; border-color: #136d62;">
          <i class="fas fa-arrow-right"></i>
          العودة للوحة التحكم
        </a>
      </div>
    </div>
  </div>

  <%- include('partials/footer') %>
</body>
</html>
